# ==== AWS Cognito (OAuth 2.0 / OpenID Connect) ====
# Dominio del Hosted UI del User Pool, SIN barra final.
# Ej: https://pedidos360-auth.auth.us-east-1.amazoncognito.com
VITE_COGNITO_AUTHORITY=https://TU_DOMINIO.auth.us-east-1.amazoncognito.com

# App Client ID (SPA, sin secret) del User Pool
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# URL de retorno registrada en el App Client (debe coincidir exactamente)
VITE_COGNITO_REDIRECT_URI=http://localhost:5173

# URL base del backend (API Gateway o EC2 directo)
VITE_API_URL=http://localhost:8080

# Issuer del User Pool (para validar el claim iss)
VITE_COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
